# Loaded by `npm start` only — production builds (Netlify) keep the
# default Render URL from src/store/gameStore.ts.
# Local backend: ../triple-triade-api (npm run build:dev + npm run dev, port 3004).
# To point dev at the deployed API instead, override per shell:
#   REACT_APP_API_URL=https://ttg-api.onrender.com/api/v1/marvel npm start
REACT_APP_API_URL=http://localhost:3004/api/v1/marvel
